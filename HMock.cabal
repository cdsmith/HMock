cabal-version:      2.4
name:               HMock
version:            0.5.2.0
synopsis:           A flexible mock framework for testing effectful code.
description:        HMock is a flexible mock framework for testing effectful
                    code in Haskell.  Tests can set up expectations about
                    actions that can or should be performed and their results,
                    and then verify those expectations when the test is
                    complete.
                    .
                    For more information, see the module documentation for
                    "Test.HMock".
category:           Testing
homepage:           https://github.com/cdsmith/HMock
bug-reports:        https://github.com/cdsmith/HMock/issues
license:            BSD-3-Clause
license-file:       LICENSE

author:             Chris Smith <cdsmith@gmail.com>
maintainer:         Chris Smith <cdsmith@gmail.com>

extra-doc-files:    CHANGELOG.md, README.md

tested-with:        GHC == 9.0.2
                     || == 9.2.8
                     || == 9.4.8
                     || == 9.6.7
                     || == 9.8.4
                     || == 9.10.3
                     || == 9.12.4
                     || == 9.14.1

source-repository head
    type:     git
    location: https://github.com/cdsmith/HMock.git

library
    exposed-modules:  Test.HMock,
                      Test.HMock.Mockable,
                      Test.HMock.Multiplicity,
                      Test.HMock.Internal.ExpectSet,
                      Test.HMock.Internal.MakeMockable,
                      Test.HMock.Internal.Match,
                      Test.HMock.Internal.Rule,
                      Test.HMock.Internal.State,
                      Test.HMock.Internal.Step,
                      Test.HMock.Internal.TH,
                      Test.HMock.Internal.Util,
                      Test.HMock.Classic,
                      Test.HMock.Classic.Defaults,
                      Test.HMock.Classic.ExpectContext,
                      Test.HMock.Classic.Internal,
                      Test.HMock.Classic.MockMethod,
                      Test.HMock.Classic.MockT,
                      Test.HMock.Classic.Rule,
                      Test.HMock.Classic.TH,
                      Test.HMock.Bluefin,
                      Test.HMock.Bluefin.Internal,
                      Test.HMock.Bluefin.Mock,
                      Test.HMock.Bluefin.TH
    build-depends:    base >= 4.15.0 && < 4.23,
                      bluefin >= 0.7 && < 0.8,
                      containers >= 0.6.2 && < 0.9,
                      data-default >= 0.7.1 && < 0.9,
                      exceptions >= 0.10.4 && < 0.11,
                      explainable-predicates >= 0.1 && < 0.2,
                      extra >= 1.7.9 && < 1.9,
                      mtl >= 2.2.2 && < 2.4,
                      syb >= 0.7.2 && < 0.8,
                      template-haskell >= 2.17 && < 2.25,
                      transformers-base >= 0.4.5 && < 0.5,
                      unliftio >= 0.2.18 && < 0.3,
    hs-source-dirs:   src
    default-language: Haskell2010
    ghc-options:      -Wall -Wcompat -Wincomplete-uni-patterns

-- Modules are grouped by what they test: Common for what every front end
-- shares, Classic and Bluefin for the two front ends, and Support for the
-- shared test tooling (a mock of Template Haskell's Quasi class).
test-suite tests
    type:             exitcode-stdio-1.0
    main-is:          Main.hs
    other-modules:    Bluefin.Capabilities,
                      Bluefin.Core,
                      Bluefin.Demo,
                      Bluefin.Manual,
                      Bluefin.Readme,
                      Bluefin.Splice,
                      Bluefin.TH,
                      Classic.Classes,
                      Classic.Core,
                      Classic.Demo,
                      Common.DocTests.All,
                      Common.DocTests.Test.HMock.Multiplicity,
                      Common.ExpectSet,
                      Common.Multiplicity,
                      Common.THUtil,
                      Support.DeriveRecursive,
                      Support.QuasiMock,
                      Support.QuasiMockBase
    build-depends:    HMock,
                      QuickCheck,
                      base,
                      bluefin,
                      data-default,
                      deepseq,
                      doctest-exitcode-stdio,
                      doctest-lib,
                      exceptions,
                      explainable-predicates,
                      extra,
                      hspec,
                      mtl,
                      syb,
                      template-haskell,
                      unliftio
    hs-source-dirs:   test
    default-language: Haskell2010
    ghc-options:      -threaded -Wall -Wcompat -Wincomplete-uni-patterns -Wno-orphans
